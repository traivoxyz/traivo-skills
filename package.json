{
  "name": "@traivo/skills",
  "version": "0.1.0",
  "description": "Agent skills for careful, read-only trading work on Ethereum: pre-trade checks, position sizing with gas, tokenized stocks vs the listed share, rug-guard review, honest call logging and move explanations.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traivoxyz/traivo-skills.git"
  },
  "homepage": "https://docs.traivo.xyz",
  "keywords": [
    "agent-skills",
    "skills",
    "trading",
    "ethereum",
    "uniswap",
    "tokenized-stocks",
    "viem",
    "traivo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:network": "TRAIVO_NETWORK_TESTS=1 vitest run tests/network.test.ts",
    "example": "tsx examples/agent-loop.ts"
  },
  "dependencies": {
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
